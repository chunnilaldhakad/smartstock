# SmartStock AI - Environment Variables Reference
# Copy this file to `.env.local` for local development.

# ==============================================================================
# SECURITY NOTICE: CLIENT ENVIRONMENT VARIABLES ARE PUBLIC
# Any variable starting with `VITE_` is statically embedded into the client
# bundle at build time and is VISIBLE to anyone inspecting browser network/sources.
#
# DO NOT put secrets, service-role keys, private API credentials, or database
# connection strings into `VITE_*` variables.
# ==============================================================================

# Supabase Project URL (Optional for preview mode; required when connecting to live backend)
# Local development default: http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous / Publishable Key (PUBLIC / CLIENT-SAFE ONLY)
# Never use SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: The frontend includes a fully functional in-browser demo store (Sharma Kirana Store)
# which runs seamlessly with or without Supabase environment variables configured.
